<?xml version="1.0" encoding="utf-8"?>
<!-- ビューアはこのActivity内のFragmentとして ep_viewer_container に表示する。
     別Activityにすると画面遷移でNFCリーダーモードの解除・再登録が発生するため。 -->
<merge
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
<LinearLayout
    style="@style/AppLayout">
  <ScrollView
      android:layout_width="match_parent"
      android:layout_height="wrap_content">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
      <TextView
          android:id="@+id/info"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:text="旅券番号、生年月日、有効期限を入力し、パスポートを読み取り位置にタッチしてください。"
          android:textSize="20sp" />
      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="8dp"
          android:gravity="end" >
          <Spinner
              android:id="@+id/spinner_ep_inputs"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:gravity="end"
              android:visibility="gone" />
      </LinearLayout>
      <TextView
          android:id="@+id/text_ep_passport_number"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="8dp"
          android:text="旅券番号(9桁)"
          android:textSize="20sp" />
      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="8dp"
          android:orientation="horizontal"
          android:gravity="center_vertical">
        <EditText
            android:id="@+id/edit_ep_passport_number"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="20sp"
            android:inputType="textVisiblePassword"
            android:maxLength="9"
            android:hint="@null"
            tools:ignore="Autofill"
            />
        <ImageButton
            android:id="@+id/button_ep_scan_mrz"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/button_background"
            android:src="@drawable/ic_camera"
            android:scaleType="centerInside"
            android:contentDescription="MRZをカメラで読み取る" />
      </LinearLayout>
      <TextView
          android:id="@+id/text_ep_birth_date"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="8dp"
          android:text="生年月日(8桁)"
          android:textSize="20sp" />
      <EditText
          android:id="@+id/edit_ep_birth_date"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="8dp"
          android:ems="10"
          android:textSize="20sp"
          android:inputType="number"
          android:maxLength="8"
          android:hint="YYYYMMDD"
          tools:ignore="Autofill" />
      <TextView
          android:id="@+id/text_ep_expire_date"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="8dp"
          android:text="有効期限(8桁)"
          android:textSize="20sp" />
      <EditText
          android:id="@+id/edit_ep_expire_date"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="8dp"
          android:ems="10"
          android:textSize="20sp"
          android:inputType="number"
          android:maxLength="8"
          android:hint="YYYYMMDD"
          tools:ignore="Autofill" />
    </LinearLayout>
  </ScrollView>
  <ScrollView
      android:id="@+id/scroll"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:layout_marginTop="8dp">
    <TextView
        android:id="@+id/message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="12sp" />
  </ScrollView>
</LinearLayout>
  <androidx.fragment.app.FragmentContainerView
      android:id="@+id/ep_viewer_container"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:visibility="gone" />
</merge>

