<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">
  <FrameLayout
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1"
      android:background="#FF000000">
    <androidx.camera.view.PreviewView
        android:id="@+id/mrz_preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
    <jp.co.osstech.jeidreader.ocr.MrzGuideOverlayView
        android:id="@+id/mrz_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="invisible" />
    <TextView
        android:id="@+id/mrz_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:padding="16dp"
        android:textColor="#FFFFFFFF"
        android:textSize="18sp"
        android:text="パスポート下部の2行(MRZ)を枠に合わせてください。" />
  </FrameLayout>
  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="horizontal"
      android:padding="8dp"
      tools:ignore="ButtonStyle">
    <Button
        android:id="@+id/mrz_button_torch"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginEnd="4dp"
        android:background="@drawable/button_background"
        android:textColor="@color/colorText"
        android:textSize="18sp"
        android:text="ライトを点ける" />
    <Button
        android:id="@+id/mrz_button_manual"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="4dp"
        android:background="@drawable/button_background"
        android:textColor="@color/colorText"
        android:textSize="18sp"
        android:text="手入力に戻る" />
  </LinearLayout>
</LinearLayout>
